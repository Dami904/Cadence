# Public frontend values
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=
NEXT_PUBLIC_KEEPER_AUTHORIZATION_ADDRESS=
NEXT_PUBLIC_TRUST_SCORE_REGISTRY_ADDRESS=
# Block CircleFactory was deployed at — bounds event log discovery so the frontend
# never scans from chain genesis. Regenerate with `node scripts/find-deploy-block.mjs`.
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=
# CadenceForwarder (ERC-2771) — same address every AjoCircle/CircleFactory instance trusts.
# Set automatically by scripts/redeploy-factory.ts; only needs a manual value if pointing the
# frontend at a factory that was deployed some other way.
NEXT_PUBLIC_CADENCE_FORWARDER_ADDRESS=
CADENCE_FORWARDER_ADDRESS=

# Deployment only — never commit a real key
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
KEEPERHUB_WALLET_ADDRESS=
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Dedicated relayer wallet that pays gas for meta-transactions submitted through
# CadenceForwarder on behalf of non-smart-account wallets (MetaMask, Rabby, etc.).
# Deliberately separate from DEPLOYER_PRIVATE_KEY.
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=
